# ─── core-api configuration ──────────────────────────────────────────────────
# Copy to .env and edit. Only AUTH_TOKEN and POSTGRES_PASSWORD have to be set
# for `docker compose up -d` to work; everything else has a working default.

# ─── Authentication ──────────────────────────────────────────────────────────

# token | oidc   (default: token)
#   token — clients send `Authorization: Bearer $AUTH_TOKEN`. No identity
#           provider needed.
#
#           ⚠️  IDENTITY IS SELF-ASSERTED IN THIS MODE. The token proves the
#           caller knows the secret, nothing more; the caller states who they
#           are with the `x-user-email` header and the server believes it. Any
#           holder of AUTH_TOKEN can therefore act as any user. Fine on a
#           trusted network (localhost, LAN, VPN, Tailscale). Not fine on a
#           server the public internet can reach — use oidc there.
#
#   oidc  — clients send a JWT from your identity provider (WorkOS, Auth0,
#           Keycloak, Okta, Dex, …). The server verifies signature and issuer,
#           and identity comes from the verified claims.
AUTH_MODE=token

# Required when AUTH_MODE=token. The shared secret clients present as their
# bearer token. Generate one: `openssl rand -hex 32`. The server refuses to
# start if this is empty.
AUTH_TOKEN=

# Required when AUTH_MODE=oidc. The exact `iss` claim your provider puts in its
# tokens. WorkOS: https://api.workos.com/user_management/<client_id>
OIDC_ISSUER=

# Required when AUTH_MODE=oidc. Your provider's JSON Web Key Set endpoint.
# WorkOS: https://api.workos.com/sso/jwks/<client_id>
OIDC_JWKS_URL=

# ─── Database ────────────────────────────────────────────────────────────────

# Password for the bundled Postgres container. Required by docker compose.
POSTGRES_PASSWORD=

# Username and database name for the bundled Postgres.
POSTGRES_USER=coreapi
POSTGRES_DB=coreapi

# Full Postgres connection string. Leave unset with docker compose — it is
# derived from the POSTGRES_* values above and points at the bundled container.
# Set it to use an external or managed database, or when running the API
# outside Docker:
# DATABASE_URL="postgresql://coreapi:password@localhost:5432/coreapi?schema=public"
DATABASE_URL=

# Only for hosted Postgres (Supabase, Neon, …) where runtime traffic goes
# through a connection pooler that cannot run DDL. Set it to the direct,
# non-pooled connection string; `prisma migrate` uses it. Defaults to
# DATABASE_URL, which is correct for plain Postgres.
DIRECT_URL=

# ─── Networking ──────────────────────────────────────────────────────────────

# Port the API listens on inside the container. Rarely needs changing.
PORT=3003

# Host port the API is published on.
API_PORT=3003

# Host interface the API is published on. 0.0.0.0 makes it reachable from your
# LAN or tailnet; 127.0.0.1 keeps it on this machine only.
#
# Note when using 127.0.0.1: that publishes on IPv4 only, and on macOS
# `localhost` resolves to the IPv6 ::1 first — where Docker answers 404 rather
# than refusing the connection, which looks like a broken server. Point the app
# at http://127.0.0.1:3003 rather than http://localhost:3003, or leave this as
# 0.0.0.0, which binds both.
API_BIND=0.0.0.0

# Only used by the optional `tls` profile
# (`docker compose --profile tls up -d`). The public hostname Caddy should
# obtain a Let's Encrypt certificate for. It must already resolve to this host,
# and ports 80 and 443 must be reachable. Leave empty if you are not using TLS —
# a domain is NOT required to run this server.
DOMAIN=

# ─── Optional features ───────────────────────────────────────────────────────

# Enables AI-suggested workspace names. Without it that endpoint returns an
# empty suggestion and everything else works normally. Nothing is sent anywhere
# unless this key is set.
GEMINI_API_KEY=
