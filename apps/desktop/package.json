{
  "name": "braid-app",
  "productName": "Braid",
  "version": "0.0.1",
  "description": "Braid \u2014 AI-native software development platform",
  "main": "./out/main/index.js",
  "author": "Braid",
  "homepage": "https://github.com/openbraid/braid",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run setup && npm run build:embedded-terminal && electron-vite dev",
    "build:embedded-terminal": "vite build --config vite.embedded-terminal.config.ts",
    "watch:embedded-terminal": "vite build --watch --config vite.embedded-terminal.config.ts",
    "build": "npm run setup && npm run build:embedded-terminal && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup:vscode-server": "bash scripts/download-vscode-server.sh",
    "setup:extension": "bash scripts/setup-extension.sh",
    "setup": "npm run setup:vscode-server && npm run setup:extension",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hocuspocus/provider": "^3.4.4",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-bubble-menu": "^3.20.4",
    "@tiptap/extension-code-block-lowlight": "^3.20.4",
    "@tiptap/extension-collaboration": "^3.20.4",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-task-item": "^3.20.4",
    "@tiptap/extension-task-list": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@tiptap/y-tiptap": "^3.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@workos-inc/node": "^8.9.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.6.2",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "get-port-please": "^3.2.0",
    "js-yaml": "^4.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "posthog-js": "^1.369.3",
    "simple-git": "^3.33.0",
    "sonner": "^2.0.7",
    "tiptap-markdown": "^0.9.0",
    "ws": "^8.19.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.9",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0"
}
